{
  "manifest_version": 2,
  "name": "NodeCloak Profile Privacy",
  "version": "0.1.0",
  "description": "Applies the privacy settings of a NodeCloak browser profile.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fingerprint@nodecloak.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["http://*/*", "https://*/*", "nativeMessaging", "webRequest", "webRequestBlocking"],
  "background": {
    "scripts": ["fingerprint.js", "background.js"],
    "persistent": true
  }
}
