FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /service ./cmd/nodecloak-server
FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 nodecloak
USER nodecloak
COPY --from=build /service /service
EXPOSE 8088
ENTRYPOINT ["/service"]
