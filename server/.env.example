LISTEN_ADDR=0.0.0.0:8088
PUBLIC_URL=https://nodecloak.com
DATABASE_URL=postgres://nodecloak:CHANGE_ME@postgres:5432/nodecloak?sslmode=disable
TOKEN_PEPPER=GENERATE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_PASSWORD=CHANGE_ME
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated existing account emails to bootstrap once as administrators.
ADMIN_EMAILS=

# Set only the actual reverse proxy peer networks. Never trust arbitrary clients.
TRUSTED_PROXIES=
